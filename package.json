{
  "dependencies": {
    "@swup/a11y-plugin": "^5.2.1",
    "@swup/body-class-plugin": "^3.3.0",
    "@swup/preload-plugin": "^3.2.12",
    "lenis": "^1.3.23",
    "swup": "^4.9.2"
  },
  "scripts": {
    "build:js": "esbuild assets/js/transitions.js --bundle --format=iife --minify --outfile=assets/js/bundle.js",
    "watch:js": "esbuild assets/js/transitions.js --bundle --format=iife --minify --sourcemap --outfile=assets/js/bundle.js --watch",
    "media:dims": "node scripts/media-dims.mjs",
    "images": "node scripts/responsive-images.mjs",
    "videos": "node scripts/video-variants.mjs",
    "media": "npm run -s media:dims && npm run -s images && npm run -s videos",
    "social": "node scripts/social-images.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "image-size": "^2.0.4",
    "sharp": "^0.35.5"
  }
}
